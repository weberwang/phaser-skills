  "properties": {
    "workItemId": {"type": "string", "minLength": 1}, "stageId": {"type": "string", "minLength": 1}, "approvalId": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "assignedAgent": {"type": "string", "minLength": 1}, "ownership": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "allowedActions": {"type": "array", "items": {"type": "string"}}, "forbiddenActions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "actionLevel": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]}, "allowedPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "forbiddenPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptanceCommands": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "completionBoundary": {"type": "string", "minLength": 1}, "outOfScopeReturn": {"type": "string", "minLength": 1}, "preserveOthersChanges": {"const": true}
  }
