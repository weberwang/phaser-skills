{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-change-request.schema.json",
  "title": "变更请求",
  "type": "object",
  "required": ["changeRequestId", "workItemId", "change", "reason", "affectedModules", "affectedBaselineHash", "invalidatedApprovalIds", "newRisk", "newAcceptance", "userDecisionRequest", "status"],
  "properties": {
    "changeRequestId": {"type": "string", "minLength": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "change": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "affectedModules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "affectedBaselineHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "invalidatedApprovalIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "newRisk": {"type": "string", "minLength": 1},
    "newAcceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "userDecisionRequest": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "APPROVED", "REJECTED"]}
  }
}
