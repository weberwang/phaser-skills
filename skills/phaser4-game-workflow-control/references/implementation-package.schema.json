        "mode": {"enum": ["generate-now", "reuse-existing", "runtime-program"]},
        "reuse_source": {"$ref": "#/$defs/reuseSnapshot"}
      }
    },
    "reuseSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_file", "source_manifest_file", "source_manifest_sha256", "source_sha256", "compatibility_evidence_file", "compatibility_evidence_sha256", "accepted_at", "source_status"],
      "properties": {
        "schema": {"const": "asset-reuse-snapshot/1.0"},
        "source_file": {"type": "string", "pattern": "\\.(?:[Pp][Nn][Gg]|[Jj][Pp](?:[Ee])?[Gg])$"},
        "source_manifest_file": {"type": "string", "minLength": 1},
        "source_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "compatibility_evidence_file": {"type": "string", "minLength": 1},
        "compatibility_evidence_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "accepted_at": {"type": "string", "format": "date-time"},
        "source_status": {"const": "accepted"}
      }
    },
    "visualDecompositionConfirmationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "state_id", "ledger_file", "receipt_id", "receipt_sha256", "confirmation_id", "confirmation_sha256", "proposal_id", "proposal_sha256", "proposal_file", "annotation_file", "annotation_sha256", "annotation_width", "annotation_height", "annotation_schema", "annotation_layout", "annotation_metadata_sha256", "annotation_identity_sha256", "decision_record_file", "decision_record_sha256", "user_decision_receipt_file", "user_decision_receipt_sha256", "target_sha256", "work_item_id", "candidate_version", "candidate_sha256", "regions"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "ledger_file": {"type": "string", "pattern": "^\\.phaser-workflow/user-resolutions/[^/]+\\.json$"},
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "confirmation_id": {"type": "string", "minLength": 1},
        "confirmation_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "proposal_id": {"type": "string", "minLength": 1},
        "proposal_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "proposal_file": {"type": "string", "minLength": 1},
        "annotation_file": {"type": "string", "pattern": "\\.(?:png)$"},
        "annotation_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "annotation_width": {"type": "integer", "minimum": 1},
        "annotation_height": {"type": "integer", "minimum": 1},
        "annotation_schema": {"const": "effect-image-annotation/png/1"},
        "annotation_layout": {"const": "image-plus-right-panel"},
        "annotation_metadata_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "annotation_identity_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "decision_record_file": {"type": "string", "minLength": 1},
        "decision_record_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "user_decision_receipt_file": {"type": "string", "minLength": 1},
        "user_decision_receipt_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "target_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "work_item_id": {"type": "string", "minLength": 1},
        "candidate_version": {"type": "string", "minLength": 1},
        "candidate_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["annotation_number", "region_id", "scene_id", "state_id", "region_definition_sha256", "production_origin", "production_method", "delivery_kind", "production_label", "component_ids", "state_ids", "asset_requirement_ids", "asset_ids", "confirmation_id", "confirmation_sha256"],
            "properties": {
              "annotation_number": {"type": "integer", "minimum": 1},
              "region_id": {"type": "string", "minLength": 1},
              "scene_id": {"type": "string", "minLength": 1},
              "state_id": {"type": "string", "minLength": 1},
              "region_definition_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "production_origin": {"type": ["string", "null"]},
              "production_method": {"type": "string", "minLength": 1},
              "delivery_kind": {"type": "string", "minLength": 1},
              "production_label": {"type": "string", "minLength": 1},
              "component_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "state_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "asset_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "confirmation_id": {"type": "string", "minLength": 1},
              "confirmation_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
