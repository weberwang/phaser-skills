      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_scope", "atomic_visual_key", "component_id", "state_id"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "asset_scope": {"const": "atomic-component"},
        "atomic_visual_key": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "asset_kind": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "runtime_file": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "alpha": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
