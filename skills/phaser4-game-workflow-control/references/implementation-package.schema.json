{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-implementation-package.schema.json",
  "title": "实施包",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageId", "workItemId", "baselineVersion", "baselineHash", "taskAuthorizationId", "approvedRequirements", "approvedArchitecture", "fileOwnership", "executionUnits", "allowedPaths", "forbiddenPaths", "expectedAddedFiles", "expectedDeletedFiles", "testScope", "outOfScope", "compatibilityStrategy", "definitionOfDone", "stopConditions"],
  "properties": {
    "packageId": {"type": "string", "minLength": 1},
    "workItemId": {"type": "string", "minLength": 1},
    "baselineVersion": {"type": "string", "minLength": 1},
    "baselineHash": {"type": "string", "pattern": "^(?:sha256:[a-f0-9]{64}|[a-f0-9]{40}(?:[a-f0-9]{24})?)$"},
    "taskAuthorizationId": {"type": "string", "minLength": 1},
    "approvedRequirements": {"$ref": "#/$defs/nonEmptyStrings"},
    "approvedArchitecture": {"type": "string", "minLength": 1},
    "fileOwnership": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "executionUnits": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/executionUnit"}
    },
    "allowedPaths": {"$ref": "#/$defs/nonEmptyStrings"},
    "forbiddenPaths": {"$ref": "#/$defs/strings"},
    "expectedAddedFiles": {"$ref": "#/$defs/strings"},
    "expectedDeletedFiles": {"$ref": "#/$defs/strings"},
    "testScope": {"$ref": "#/$defs/nonEmptyStrings"},
    "outOfScope": {"$ref": "#/$defs/strings"},
    "compatibilityStrategy": {"type": "string", "minLength": 1},
    "definitionOfDone": {"$ref": "#/$defs/nonEmptyStrings"},
    "stopConditions": {"$ref": "#/$defs/nonEmptyStrings"},
    "visualContractVersion": {"type": "string", "minLength": 1},
    "candidateVersion": {"type": "string", "minLength": 1},
    "visualManifestFile": {"type": "string", "minLength": 1},
    "visualManifestSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "visualDecompositionConfirmations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visualDecompositionConfirmationGroup"}},
    "current_stage": {"enum": ["V3", "V4", "V5"]},
    "currentStage": {"enum": ["V3", "V4", "V5"]},
    "scene_reconstruction_contract": {"$ref": "#/$defs/sceneReconstructionContract"},
    "sceneReconstructionContract": {"$ref": "#/$defs/sceneReconstructionContract"},
    "visualProductionUnits": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/visualProductionUnit"}
    }
  },
  "allOf": [
    {
      "if": {"anyOf": [{"required": ["visualContractVersion"]}, {"required": ["candidateVersion"]}, {"required": ["visualManifestFile"]}, {"required": ["visualManifestSha256"]}, {"required": ["visualProductionUnits"]}]},
      "then": {"required": ["visualContractVersion", "candidateVersion", "visualManifestFile", "visualManifestSha256", "visualProductionUnits"]}
    },
    {
      "if": {"required": ["visualProductionUnits"], "properties": {"visualProductionUnits": {"minItems": 1}}},
      "then": {"required": ["visualDecompositionConfirmations"]}
    },
    {
      "if": {"anyOf": [{"required": ["current_stage"], "properties": {"current_stage": {"enum": ["V4", "V5"]}}}, {"required": ["currentStage"], "properties": {"currentStage": {"enum": ["V4", "V5"]}}}]},
      "then": {
        "allOf": [
          {"anyOf": [{"required": ["scene_reconstruction_contract"], "properties": {"scene_reconstruction_contract": {"required": ["combination_preacceptance"]}}}, {"required": ["sceneReconstructionContract"], "properties": {"sceneReconstructionContract": {"required": ["combination_preacceptance"]}}}]},
          {"properties": {"visualProductionUnits": {"items": {"required": ["scene_asset_usage"]}}}}
        ]
      }
    }
  ],
  "$defs": {
    "executionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "unitType", "scopeId", "moduleId", "sceneId", "owner", "dependsOn", "parallelMode", "parallelGroup", "ownedPaths", "stateOwnership", "acceptanceCommands", "serializationReason"],
      "properties": {
        "unitId": {"type": "string", "minLength": 1},
        "unitType": {"enum": ["MODULE", "SCENE", "SHARED", "INTEGRATION"]},
        "scopeId": {"type": "string", "minLength": 1},
        "moduleId": {"type": "string", "minLength": 1},
        "sceneId": {"type": ["string", "null"], "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "dependsOn": {"$ref": "#/$defs/strings"},
        "parallelMode": {"enum": ["PARALLEL", "SERIAL"]},
        "parallelGroup": {"type": ["string", "null"], "minLength": 1},
        "ownedPaths": {"$ref": "#/$defs/nonEmptyStrings"},
        "stateOwnership": {"$ref": "#/$defs/nonEmptyStrings"},
        "acceptanceCommands": {"$ref": "#/$defs/nonEmptyStrings"},
        "serializationReason": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"unitType": {"const": "SCENE"}}},
          "then": {"properties": {"sceneId": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"sceneId": {"type": "null"}}}
        },
        {
          "if": {"properties": {"unitType": {"enum": ["SHARED", "INTEGRATION"]}}},
          "then": {"properties": {"parallelMode": {"const": "SERIAL"}, "parallelGroup": {"type": "null"}, "serializationReason": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"parallelMode": {"const": "PARALLEL"}}},
          "then": {"properties": {"parallelGroup": {"type": "string", "minLength": 1}, "serializationReason": {"type": "null"}}}
        },
        {
          "if": {"properties": {"parallelMode": {"const": "SERIAL"}}},
          "then": {"properties": {"parallelGroup": {"type": "null"}, "serializationReason": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "visualOutputPaths": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "share_id": {"type": "string", "minLength": 1},
            "shareId": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {"oneOf": [{"required": ["file"], "not": {"required": ["path"]}}, {"required": ["path"], "not": {"required": ["file"]}}]},
            {"not": {"required": ["share_id", "shareId"]}}
          ]
        }
      ]}
    },
    "visualProductionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "annotation_number", "region_id", "scene_id", "state_id", "owner_type", "production_origin", "production_method", "production_label", "delivery_kind", "image_generation_required", "generation_record_required", "substitution_policy", "decomposition_confirmation_id", "decomposition_confirmation_sha256", "owner", "ownedPaths", "outputPaths"],
      "properties": {
        "unitId": {"type": "string", "minLength": 1},
        "annotation_number": {"type": "integer", "minimum": 1},
      "region_id": {"type": "string", "minLength": 1},
      "scene_id": {"type": "string", "minLength": 1},
      "state_id": {"type": "string", "minLength": 1},
      "owner_type": {"enum": ["fixed-production-visual", "runtime-data", "runtime-rendered"]},
        "production_origin": {"enum": ["bitmap-decomposition", "independent-production"]},
        "production_method": {"enum": ["imagegen", "authored-raster", "authored-svg", "phaser-graphics", "runtime-program", "reuse"]},
        "production_label": {"type": "string", "minLength": 1},
        "delivery_kind": {"enum": ["raster-image", "vector-image", "runtime-drawing", "runtime-program", "existing-asset"]},
        "image_generation_required": {"type": "boolean"},
        "generation_record_required": {"type": "boolean"},
         "substitution_policy": {"enum": ["forbid", "user-change-request-only"]},
         "implementation_plan": {"$ref": "#/$defs/implementationPlan"},
         "reuse_snapshot": {"$ref": "#/$defs/reuseSnapshot"},
         "decomposition_confirmation_id": {"type": "string", "minLength": 1},
        "decomposition_confirmation_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "asset_id": {"type": "string", "minLength": 1},
        "asset_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "state_analysis": {"$ref": "#/$defs/stateAnalysis"},
        "component_inventory": {"$ref": "#/$defs/componentInventory"},
        "owner": {"type": "string", "minLength": 1},
        "ownedPaths": {"$ref": "#/$defs/nonEmptyStrings"},
        "outputPaths": {"$ref": "#/$defs/visualOutputPaths"},
        "expected_assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visualExpectedAsset"}},
        "atomic_image_requirements": {"type": "array", "items": {"$ref": "#/$defs/atomicImageRequirement"}},
        "interaction_hotspots": {"type": "array", "items": {"$ref": "#/$defs/interactionHotspot"}},
        "runtime_implementation": {"$ref": "#/$defs/runtimeImplementation"},
        "scene_asset_usage": {"$ref": "#/$defs/sceneAssetUsage"},
        "sceneAssetUsage": {"$ref": "#/$defs/sceneAssetUsage"},
        "format": {"type": "string", "minLength": 1},
        "output_sharing": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["owner_type"], "properties": {"owner_type": {"const": "fixed-production-visual"}}},
          "then": {
            "required": ["state_analysis", "component_inventory", "expected_assets", "atomic_image_requirements", "interaction_hotspots"],
            "properties": {
              "production_method": {"enum": ["imagegen", "authored-raster", "reuse"]},
              "delivery_kind": {"enum": ["raster-image", "existing-asset"]},
              "expected_assets": {"minItems": 1, "items": {"properties": {"source_file": {"pattern": "\\.(?:[Pp][Nn][Gg]|[Jj][Pp](?:[Ee])?[Gg])$"}, "runtime_file": {"pattern": "\\.(?:[Pp][Nn][Gg]|[Jj][Pp](?:[Ee])?[Gg])$"}, "mime_type": {"enum": ["image/png", "image/jpeg"]}}}},
              "atomic_image_requirements": {"items": {"properties": {"production_method": {"enum": ["imagegen", "authored-raster", "reuse"]}, "delivery_kind": {"enum": ["raster-image", "existing-asset"]}}}}
            }
          }
        },
        {
          "if": {"required": ["owner_type"], "properties": {"owner_type": {"enum": ["runtime-data", "runtime-rendered"]}}},
          "then": {
            "required": ["runtime_implementation"],
            "not": {"anyOf": [
              {"required": ["component_inventory"]},
              {"required": ["asset_id"]},
              {"required": ["asset_ids"]},
              {"required": ["expected_assets"]},
              {"required": ["actual_assets"]},
              {"required": ["atomic_image_requirements"]},
              {"required": ["interaction_hotspots"]}
            ]},
            "properties": {
              "production_method": {"enum": ["phaser-graphics", "runtime-program"]},
              "delivery_kind": {"enum": ["runtime-drawing", "runtime-program"]},
              "image_generation_required": {"const": false},
              "generation_record_required": {"const": false},
              "runtime_implementation": {"required": ["kind", "integration_files"]}
            }
          }
        },
        {
          "if": {"required": ["image_generation_required"], "properties": {"image_generation_required": {"const": true}}},
          "then": {
            "required": ["production_method", "delivery_kind", "generation_record_required", "substitution_policy", "component_inventory", "scene_asset_usage"],
            "properties": {
              "production_method": {"const": "imagegen"},
              "delivery_kind": {"const": "raster-image"},
              "generation_record_required": {"const": true},
              "substitution_policy": {"const": "user-change-request-only"},
              "component_inventory": {"required": ["delivery_mode", "atlas_allowed"], "properties": {"delivery_mode": {"const": "individual"}, "atlas_allowed": {"const": false}}},
              "expected_assets": {"items": {"$ref": "#/$defs/imageGenerationExpectedAsset"}},
              "scene_asset_usage": {"required": ["target_display_size", "intended_scale_range", "max_dpr", "padding_policy"], "properties": {"max_dpr": {"type": "number", "exclusiveMinimum": 0}, "padding_policy": {"const": "none"}}}
            }
          }
        },
        {
          "if": {"required": ["production_method"], "properties": {"production_method": {"const": "imagegen"}}},
          "then": {
            "required": ["component_inventory", "scene_asset_usage"],
            "not": {"required": ["runtime_implementation"]},
            "properties": {
              "delivery_kind": {"const": "raster-image"},
              "image_generation_required": {"const": true},
              "generation_record_required": {"const": true},
              "substitution_policy": {"const": "user-change-request-only"},
              "component_inventory": {"required": ["delivery_mode", "atlas_allowed"], "properties": {"delivery_mode": {"const": "individual"}, "atlas_allowed": {"const": false}}},
              "expected_assets": {"items": {"$ref": "#/$defs/imageGenerationExpectedAsset"}},
              "scene_asset_usage": {"required": ["target_display_size", "intended_scale_range", "max_dpr", "padding_policy"], "properties": {"max_dpr": {"type": "number", "exclusiveMinimum": 0}, "padding_policy": {"const": "none"}}}
            }
          }
        },
        {
          "if": {"required": ["production_method"], "properties": {"production_method": {"const": "authored-raster"}}},
          "then": {"not": {"required": ["runtime_implementation"]}, "properties": {"delivery_kind": {"const": "raster-image"}, "image_generation_required": {"const": false}, "expected_assets": {"items": {"required": ["source_file", "runtime_file"]}}}}
        },
        {
          "if": {"required": ["production_method"], "properties": {"production_method": {"const": "authored-svg"}}},
          "then": {"not": {"required": ["runtime_implementation"]}, "properties": {"delivery_kind": {"const": "vector-image"}, "image_generation_required": {"const": false}, "expected_assets": {"items": {"required": ["source_file", "runtime_file"]}}}}
        },
         {
           "if": {"required": ["production_method"], "properties": {"production_method": {"const": "reuse"}}},
           "then": {"required": ["implementation_plan", "reuse_snapshot"], "not": {"required": ["runtime_implementation"]}, "properties": {"delivery_kind": {"const": "existing-asset"}, "image_generation_required": {"const": false}, "expected_assets": {"items": {"required": ["source_file", "runtime_file"]}}, "implementation_plan": {"properties": {"mode": {"const": "reuse-existing"}}}}}
        },
        {
          "if": {"required": ["production_method"], "properties": {"production_method": {"const": "phaser-graphics"}}},
          "then": {
            "required": ["runtime_implementation"],
            "properties": {
              "delivery_kind": {"const": "runtime-drawing"},
              "image_generation_required": {"const": false},
              "runtime_implementation": {"required": ["kind", "integration_files"], "properties": {"kind": {"const": "phaser-graphics"}}},
              "expected_assets": {"items": {"not": {"anyOf": [{"required": ["source_file"]}, {"required": ["runtime_file"]}]}}}
            }
          }
        },
        {
          "if": {"required": ["production_method"], "properties": {"production_method": {"const": "runtime-program"}}},
          "then": {
            "required": ["runtime_implementation"],
            "properties": {
              "delivery_kind": {"const": "runtime-program"},
              "image_generation_required": {"const": false},
              "runtime_implementation": {"required": ["kind", "integration_files"], "properties": {"kind": {"const": "runtime-program"}}},
              "expected_assets": {"items": {"not": {"anyOf": [{"required": ["source_file"]}, {"required": ["runtime_file"]}]}}}
            }
          }
        },
        {
          "if": {"required": ["delivery_kind"], "properties": {"delivery_kind": {"enum": ["raster-image", "vector-image", "existing-asset"]}}},
          "then": {"properties": {"expected_assets": {"items": {"required": ["source_file", "runtime_file"]}}}}
        },
        {
          "if": {"required": ["production_origin"], "properties": {"production_origin": {"const": "bitmap-decomposition"}}},
          "then": {
            "required": ["decomposition_confirmation_id", "decomposition_confirmation_sha256"],
            "properties": {
              "production_method": {"enum": ["imagegen", "authored-raster", "reuse"]},
              "delivery_kind": {"enum": ["raster-image", "existing-asset"]}
            }
          }
        }
      ]
    },
    "sceneReconstructionContract": {
      "type": "object",
      "description": "effect-image V1-V5 场景还原合同；V1 必须显式记录冲突，V2 产物和结构化审查缺失时不得进入 V3。",
      "required": ["contract_version", "reference_technical_conflicts", "v2_scene_candidate", "v2_dynamic_sample", "v2_structured_review", "target_conditions", "coverage_regions", "composition", "responsive_contract", "predeclared_tolerances", "implementation_plan"],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "reference_technical_conflicts": {"$ref": "#/$defs/referenceTechnicalConflicts"},
        "v2_scene_candidate": {"$ref": "#/$defs/v2Artifact"},
        "v2_dynamic_sample": {"$ref": "#/$defs/v2Artifact"},
        "v2_structured_review": {"$ref": "#/$defs/v2StructuredReview"},
        "target_conditions": {"type": "object"},
        "coverage_regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sceneCoverageRegion"}},
        "composition": {"type": "object", "minProperties": 1},
        "responsive_contract": {"type": "object", "minProperties": 1},
        "predeclared_tolerances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "rules"]}},
        "implementation_plan": {"type": "object", "minProperties": 1},
        "combination_preacceptance": {"$ref": "#/$defs/combinationPreacceptance"}
      },
      "additionalProperties": true
    },
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "referenceTechnicalConflicts": {
      "type": "array",
      "items": {"type": "object", "minProperties": 1}
    },
    "artifactIdentity": {
      "type": "object",
      "required": ["diff_fingerprint"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "diff_fingerprint": {"type": "string", "minLength": 1},
        "diff_identity": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["sha256"]}, {"required": ["code_sha256"]}, {"required": ["build_sha256"]}, {"required": ["candidate_sha256"]}]
    },
    "evidenceValue": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": ["string", "object"]}},
        {"type": "object", "minProperties": 1}
      ]
    },
    "humanReview": {
      "type": "object",
      "required": ["reviewer_type", "reviewer_id", "reviewed_at", "evidence", "status"],
      "properties": {
        "reviewer_type": {"const": "human"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidenceValue"},
        "status": {"enum": ["passed", "PASS", "failed", "FAIL"]},
        "target_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "diff_fingerprint": {"type": "string", "minLength": 1},
        "diff_identity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "v2Artifact": {
      "type": "object",
      "required": ["identity", "evidence", "human_review"],
      "properties": {
        "identity": {"$ref": "#/$defs/artifactIdentity"},
        "evidence": {"$ref": "#/$defs/evidenceValue"},
        "human_review": {"$ref": "#/$defs/humanReview"}
      },
      "additionalProperties": true
    },
    "v2StructuredReview": {
      "type": "object",
      "required": ["reviewer_type", "reviewer_id", "reviewed_at", "evidence", "status", "reviewed_target_identity", "reviewed_candidate_identity", "full_viewport_comparison", "per_region_review", "composition_review", "geometry_review", "color_material_review", "typography_review", "decoration_density_review", "responsive_review"],
      "properties": {
        "reviewer_type": {"const": "human"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence": {"$ref": "#/$defs/evidenceValue"},
        "status": {"enum": ["passed", "PASS", "failed", "FAIL"]},
        "reviewed_target_identity": {"type": "object", "minProperties": 1},
        "reviewed_candidate_identity": {"type": "object", "minProperties": 1},
        "full_viewport_comparison": {"$ref": "#/$defs/evidenceValue"},
        "per_region_review": {"type": "array", "minItems": 1},
        "composition_review": {"type": "object", "minProperties": 1},
        "geometry_review": {"type": "object", "minProperties": 1},
        "color_material_review": {"type": "object", "minProperties": 1},
        "typography_review": {"type": "object", "minProperties": 1},
        "decoration_density_review": {"type": "object", "minProperties": 1},
        "responsive_review": {"type": "object", "minProperties": 1},
        "unresolved_differences": {"type": "array"},
        "findings": {"type": "array"}
      }
    },
    "sceneCoverageRegion": {
      "type": "object",
      "required": ["annotation_number", "region_id", "target_bounds", "coordinate_space", "anchor_reference", "relative_alignment", "z_order", "target_visibility", "size_strategy", "spacing", "typography_facts", "color_facts", "material_texture_facts", "lighting_shadow_facts", "decorative_density_facts", "clipping_cropping_facts", "responsive_behavior", "implementation_owner", "implementation_plan", "applicable_states", "evidence", "tolerance_reference", "approved_exception_ids"],
      "properties": {
        "annotation_number": {"type": "integer", "minimum": 1},
        "region_id": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "target_bounds": {"type": "object", "required": ["x", "y", "width", "height"]},
        "coordinate_space": {"type": "string", "minLength": 1},
        "anchor_reference": {"type": "string", "minLength": 1},
        "relative_alignment": {"type": "object", "minProperties": 1},
        "z_order": {"type": ["string", "number"], "minLength": 1},
        "target_visibility": {"type": ["string", "boolean"], "minLength": 1},
        "size_strategy": {"type": "object", "minProperties": 1},
        "spacing": {"type": "object", "minProperties": 1},
        "typography_facts": {"type": "object", "minProperties": 1},
        "color_facts": {"type": "object", "minProperties": 1},
        "material_texture_facts": {"type": "object", "minProperties": 1},
        "lighting_shadow_facts": {"type": "object", "minProperties": 1},
        "decorative_density_facts": {"type": "object", "minProperties": 1},
        "clipping_cropping_facts": {"type": "object", "minProperties": 1},
        "responsive_behavior": {"type": "object", "minProperties": 1},
        "implementation_owner": {"type": "string", "minLength": 1},
        "implementation_plan": {"type": "object", "minProperties": 1},
        "applicable_states": {"type": "array", "minItems": 1},
        "evidence": {"$ref": "#/$defs/evidenceValue"},
        "tolerance_reference": {"type": "string", "minLength": 1},
        "approved_exception_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "fidelity_obligations": {"type": ["object", "array", "string"]},
        "scene_asset_usage": {"$ref": "#/$defs/sceneAssetUsage"}
      },
      "additionalProperties": true
    },
    "combinationPreacceptance": {
      "type": "object",
      "required": ["status", "formal_scene_structure", "layout_calculation_identity", "evidence", "target_sha256", "candidate_sha256", "diff_fingerprint", "reviewer_type", "reviewer_id", "reviewed_at"],
      "properties": {
        "reviewer_type": {"const": "human"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["passed", "PASS"]},
        "formal_scene_structure": {"type": "string", "minLength": 1},
        "layout_calculation_identity": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceValue"},
        "target_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "diff_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "normalizationProof": {
      "type": "object",
      "required": ["target", "candidate", "equivalent"],
      "properties": {
        "target": {},
        "candidate": {},
        "equivalent": {"const": true}
      }
    },
    "normalizationEquivalence": {
      "type": "object",
      "required": ["viewport", "dpr", "logical_coordinates"],
      "properties": {
        "viewport": {"$ref": "#/$defs/normalizationProof"},
        "dpr": {"$ref": "#/$defs/normalizationProof"},
        "logical_coordinates": {"$ref": "#/$defs/normalizationProof"}
      }
    },
    "differenceEvidence": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": ["string", "object"]}},
        {"type": "object", "required": ["status", "reason"], "properties": {"status": {"enum": ["not-applicable", "na", "n/a"]}, "reason": {"type": "string", "minLength": 1}}},
        {"type": "object", "not": {"required": ["status"]}, "anyOf": [{"required": ["path"]}, {"required": ["file"]}, {"required": ["evidence"]}, {"required": ["evidence_path"]}, {"required": ["evidence_sha256"]}, {"required": ["sha256"]}, {"required": ["paths"]}], "properties": {"path": {"type": "string", "minLength": 1}, "file": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "evidence_path": {"type": "string", "minLength": 1}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "sha256": {"$ref": "#/$defs/sha256"}, "paths": {"type": "array", "minItems": 1}}}
      ]
    },
    "fidelityRegionResult": {
      "type": "object",
      "required": ["region_id", "target_measurement", "candidate_measurement", "delta", "tolerance_reference", "result", "evidence", "exception_ids", "human_review"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "target_measurement": {"type": ["number", "string", "boolean", "object", "array"], "minItems": 1},
        "candidate_measurement": {"type": ["number", "string", "boolean", "object", "array"], "minItems": 1},
        "delta": {"type": ["number", "object", "array", "string"]},
        "tolerance_reference": {"type": "string", "minLength": 1},
        "result": {"enum": ["passed", "PASS", "failed", "FAIL"]},
        "evidence": {"$ref": "#/$defs/evidenceValue"},
        "exception_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        ,"human_review": {"$ref": "#/$defs/humanReview"}
      }
    },
    "structuredFidelityCase": {
      "type": "object",
      "required": ["target_identity", "candidate_identity", "scene_id", "state_id", "viewport", "dpr", "locale", "random_seed", "input_trace", "animation_sample", "original_target_size", "original_candidate_size", "normalization_transform", "normalization_equivalence", "normalized_comparison_canvas", "full_viewport_reference", "full_viewport_candidate", "side_by_side_evidence", "overlay_evidence", "difference_evidence", "tolerance_set", "per_region_results", "conclusion", "human_review"],
      "properties": {
        "target_identity": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
        "candidate_identity": {"$ref": "#/$defs/artifactIdentity"},
        "scene_id": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "minLength": 1},
        "viewport": {"type": "object", "required": ["width", "height"]},
        "dpr": {"type": "number", "exclusiveMinimum": 0},
        "locale": {"type": "string", "minLength": 1},
        "random_seed": {"type": ["integer", "string"], "minLength": 1},
        "input_trace": {"type": "string", "minLength": 1},
        "animation_sample": {"type": "string", "minLength": 1},
        "original_target_size": {"type": "object", "required": ["width", "height"]},
        "original_candidate_size": {"type": "object", "required": ["width", "height"]},
        "normalization_transform": {"type": "object", "minProperties": 1},
        "normalization_equivalence": {"$ref": "#/$defs/normalizationEquivalence"},
        "normalized_comparison_canvas": {"type": "object", "required": ["width", "height"]},
        "full_viewport_reference": {"$ref": "#/$defs/evidenceValue"},
        "full_viewport_candidate": {"$ref": "#/$defs/evidenceValue"},
        "side_by_side_evidence": {"$ref": "#/$defs/evidenceValue"},
        "overlay_evidence": {"$ref": "#/$defs/evidenceValue"},
        "difference_evidence": {"$ref": "#/$defs/differenceEvidence"},
        "tolerance_set": {"type": ["object", "array"], "minItems": 1},
        "per_region_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fidelityRegionResult"}},
        "conclusion": {"enum": ["passed", "PASS", "failed", "FAIL"]},
        "human_review": {"$ref": "#/$defs/humanReview"}
      }
    },
    "sceneAssetUsage": {
      "type": "object",
      "description": "V4 资源放入正式 Scene 后的目标显示和组合条件；不能只用独立图片尺寸替代。",
      "required": ["target_display_size", "intended_scale_range", "origin", "anchor", "nine_slice", "material", "composition_region", "required_neighbors", "typography_ownership", "runtime_foreground_ownership"],
      "properties": {
        "target_display_size": {"type": "object", "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
        "intended_scale_range": {"type": "object", "required": ["min", "max"], "properties": {"min": {"type": "number", "exclusiveMinimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}}},
        "max_dpr": {"type": "number", "exclusiveMinimum": 0, "description": "运行时允许的最大设备像素比；ImageGen 单图尺寸计算只使用该机器合同字段。"},
        "padding_policy": {"type": "string", "description": "ImageGen individual 必须为 none；非 ImageGen 可不声明该字段。"},
        "origin": {"type": "object"},
        "anchor": {"type": ["string", "object"], "minLength": 1},
        "nine_slice": {"type": ["string", "object"]},
        "material": {"type": ["string", "object"]},
        "composition_region": {"type": ["string", "object"], "minLength": 1},
        "required_neighbors": {"type": "array"},
        "typography_ownership": {"type": ["string", "object"], "minLength": 1},
        "runtime_foreground_ownership": {"type": ["string", "object"], "minLength": 1}
      },
      "additionalProperties": true
    },
    "stateAnalysisState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "requirement", "reason"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "not-applicable"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "stateAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase", "evidence", "evidence_sha256", "reference_target_sha256", "analysis_id", "completed_at", "states"],
      "properties": {
        "status": {"const": "complete"},
        "phase": {"const": "before-component-splitting"},
        "evidence": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "reference_target_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "analysis_id": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "format": "date-time"},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateAnalysisState"}}
      }
    },
    "componentStateCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "requirement", "reason"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["required", "not-applicable"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "componentInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "atomic_visual_key", "role", "reusable", "state_coverage", "placements"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "atomic_visual_key": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "reusable": {"type": "boolean"},
        "state_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentStateCoverage"}},
        "placements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visualPlacement"}}
      }
    },
    "componentInventory": {
      "type": "object",
