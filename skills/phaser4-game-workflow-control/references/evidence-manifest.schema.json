    "globalVisualGenerationRecord": {"type": "object", "required": ["origin", "visual_baseline_id", "visual_baseline_version", "style_fingerprint", "baseline_document", "style_reference_inputs", "global_visual_consistency_prompt", "style_drift_policy", "full_prompt", "prompt_sent", "target_sha256", "output_sha256", "consistency_status", "consistency_evidence"], "properties": {"origin": {"const": "generated"}, "visual_baseline_id": {"type": "string", "minLength": 1}, "visual_baseline_version": {"type": "string", "minLength": 1}, "style_fingerprint": {"$ref": "#/$defs/sha256"}, "baseline_document": {"const": "docs/visual-baseline.md"}, "style_reference_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/globalStyleReferenceInput"}}, "global_visual_consistency_prompt": {"type": "string", "minLength": 1}, "style_drift_policy": {"const": "forbid"}, "full_prompt": {"type": "string", "minLength": 1}, "prompt_sent": {"const": true}, "target_sha256": {"$ref": "#/$defs/sha256"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "consistency_status": {"const": "passed"}, "consistency_evidence": {"$ref": "#/$defs/globalConsistencyEvidence"}}, "additionalProperties": true},
    "imageGenerationRecord": {"allOf": [{"$ref": "#/$defs/globalVisualGenerationRecord"}, {"type": "object", "properties": {"normalization_record": {"$ref": "#/$defs/imageNormalizationRecord"}}}]},
