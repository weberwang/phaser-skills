    "v2Artifact": {"type": "object", "required": ["identity", "evidence"], "properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "evidence": {"$ref": "#/$defs/evidenceValue"}, "origin": {"enum": ["provided", "generated"]}, "generation_record": {"$ref": "#/$defs/globalVisualGenerationRecord"}, "visual_human_approval_id": {"type": "string", "minLength": 1}, "visual_human_approval_sha256": {"$ref": "#/$defs/sha256"}}, "allOf": [{"if": {"required": ["origin"], "properties": {"origin": {"const": "generated"}}}, "then": {"required": ["generation_record"]}}, {"if": {"required": ["origin"], "properties": {"origin": {"const": "provided"}}}, "then": {"not": {"required": ["generation_record"]}}}], "not": {"anyOf": [{"required": ["reviewer"]}, {"required": ["reviewer_type"]}, {"required": ["reviewerType"]}, {"required": ["reviewer_id"]}, {"required": ["reviewerId"]}, {"required": ["review_id"]}, {"required": ["reviewId"]}, {"required": ["reviewed_at"]}, {"required": ["reviewedAt"]}, {"required": ["human_review"]}, {"required": ["humanReview"]}, {"required": ["f2_review"]}, {"required": ["f2_reviews"]}, {"required": ["f2Review"]}, {"required": ["f2Reviews"]}, {"required": ["visual_fidelity_review"]}, {"required": ["visualFidelityReview"]}, {"required": ["production_contract_review"]}, {"required": ["productionContractReview"]}, {"required": ["component_reviews"]}, {"required": ["componentReviews"]}]}, "additionalProperties": true},
