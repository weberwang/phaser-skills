{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-evidence-manifest.schema.json",
  "title": "证据清单",
  "type": "object",
  "required": ["evidenceId", "batchId", "workItemId", "baselineHash", "codeFingerprint", "diffFingerprint", "recordedAt", "commands", "environment", "dataSources", "files", "fileHashes", "gateResults", "verdict", "uncoveredItems", "completedOutputs", "completedUnitIds", "satisfiedExitCriteria"],
  "properties": {
    "evidenceId": {"type": "string"}, "batchId": {"type": "string"}, "workItemId": {"type": "string"}, "baselineHash": {"type": "string", "pattern": "^(?:sha256:[a-f0-9]{64}|[a-f0-9]{40}(?:[a-f0-9]{24})?)$"}, "codeFingerprint": {"type": "string"}, "diffFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "recordedAt": {"type": "string", "format": "date-time"},
    "commands": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "exitCode", "outputFile", "outputHash"]}}, "environment": {"type": "object"}, "dataSources": {"type": "array", "items": {"type": "string"}}, "files": {"type": "array", "items": {"type": "string"}}, "fileHashes": {"type": "object"}, "gateResults": {"type": "object", "required": ["F0", "F1", "F2", "F3"], "properties": {"F2": {"type": "object", "required": ["status", "baselineHash", "diffFingerprint", "reviewer", "reviewMode"], "properties": {"reviewMode": {"enum": ["SELF", "INDEPENDENT"]}, "reviewer": {"type": "string", "minLength": 1}}}}}, "verdict": {"enum": ["PASS", "FAIL", "PARTIAL"]}, "uncoveredItems": {"type": "array", "items": {"type": "string"}}, "completedOutputs": {"type": "array", "items": {"type": "string"}}, "completedUnitIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "satisfiedExitCriteria": {"type": "array", "items": {"type": "string"}}
  }
}
