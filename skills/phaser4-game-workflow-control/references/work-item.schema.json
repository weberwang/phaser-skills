{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-work-item.schema.json",
  "title": "工作项",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workItemId",
    "projectId",
    "moduleIds",
    "domain",
    "stageId",
    "globalState",
    "baselineId",
    "baselineVersion",
    "baselineHash",
    "objective",
    "taskAuthorization",
    "inScope",
    "outOfScope",
    "approvedRequirements",
    "allowedActions",
    "allowedActionLevels",
    "explicitApprovalActionLevels",
    "prohibitedActions",
    "allowedPaths",
    "forbiddenPaths",
    "allowedExternalTargets",
    "protectedExternalTargets",
    "requiredGates",
    "approvalRecord",
    "assignedAgent",
    "delegatedAgents",
    "expectedOutputs",
    "validationPlan",
    "exitCriteria",
    "nextGate",
    "rollbackPolicy",
    "evidenceRoot",
    "pendingApprovalId",
    "pendingApprovalObject",
    "pendingApprovalStage",
    "pendingApprovalActionLevel",
    "pendingApprovalGate",
    "pendingApprovalState",
    "pendingApprovalContext",
    "pendingApprovalActionType",
    "pendingApprovalImpactSummary",
    "pendingApprovalFileScope",
    "pendingApprovalServices",
    "pendingApprovalAllowServiceStart",
    "pendingApprovalAllowDelete",
    "pendingApprovalExternalWrite",
    "pendingApprovalDestructive",
    "pendingApprovalPhysicalDevice",
    "pendingApprovalRelease",
    "pendingApprovalExternalTargets",
    "pendingApprovalPreparedAt",
    "pendingApprovalPresentedId",
    "pendingApprovalPresentedAt",
    "validationBatchId",
    "changeRequestFiles"
  ],
  "properties": {
    "workItemId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "moduleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "globalState": {
      "enum": [
        "INTAKE",
        "BASELINE",
        "PROPOSAL",
        "REVIEW",
        "IMPLEMENTING",
        "VALIDATING",
        "PASSED",
        "INTEGRATING",
        "RELEASE_APPROVAL_REQUIRED",
        "RELEASING",
        "COMPLETE",
        "RETURN",
        "BLOCKED"
      ]
    },
    "baselineId": {
      "type": "string",
      "minLength": 1
    },
    "baselineVersion": {
      "type": "string",
      "minLength": 1
    },
    "baselineHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "taskAuthorization": {
      "type": "object",
      "required": [
        "authorizationId",
        "userOriginalText",
        "authorizedObjective",
        "authorizedScope",
        "authorizedActions",
        "authorizedActionLevels",
        "authorizedPaths",
        "authorizedAt"
      ],
      "properties": {
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "userOriginalText": {
          "type": "string",
          "minLength": 1
        },
        "authorizedObjective": {
          "type": "string",
          "minLength": 1
        },
        "authorizedScope": {
          "$ref": "#/$defs/strings"
        },
        "authorizedActions": {
          "$ref": "#/$defs/automaticPhaserActions"
        },
        "authorizedActionLevels": {
          "type": "array",
          "items": {
            "enum": [
              "A0",
              "A1",
              "A2",
              "A3"
            ]
          }
        },
        "authorizedPaths": {
          "$ref": "#/$defs/strings"
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "inScope": {
      "$ref": "#/$defs/strings"
    },
    "outOfScope": {
      "$ref": "#/$defs/strings"
    },
    "approvedRequirements": {
      "$ref": "#/$defs/strings"
    },
    "allowedActions": {
      "$ref": "#/$defs/actions"
    },
    "allowedActionLevels": {
      "type": "array",
      "items": {
        "enum": [
          "A0",
          "A1",
          "A2",
          "A3"
        ]
      }
    },
    "explicitApprovalActionLevels": {
      "type": "array",
      "items": {
        "enum": [
          "A4",
          "A5",
          "A6"
        ]
      }
    },
    "prohibitedActions": {
      "$ref": "#/$defs/actions"
    },
    "allowedPaths": {
      "$ref": "#/$defs/strings"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/strings"
    },
    "allowedExternalTargets": {
      "$ref": "#/$defs/strings"
    },
    "protectedExternalTargets": {
      "$ref": "#/$defs/strings"
    },
    "requiredGates": {
      "type": "array",
      "items": {
        "enum": [
          "F0",
          "F1",
          "F2",
          "F3",
          "F4"
        ]
      }
    },
    "approvalRecord": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignedAgent": {
      "type": "string",
      "minLength": 1
    },
    "delegatedAgents": {
      "$ref": "#/$defs/strings"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/strings"
    },
    "validationPlan": {
      "$ref": "#/$defs/strings"
    },
    "exitCriteria": {
      "$ref": "#/$defs/strings"
    },
    "nextGate": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ]
    },
    "rollbackPolicy": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRoot": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalId": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalObject": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalStage": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalActionLevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6"
      ]
    },
    "pendingApprovalGate": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ]
    },
    "pendingApprovalState": {
      "enum": [
        "INTAKE",
        "BASELINE",
        "PROPOSAL",
        "REVIEW",
        "IMPLEMENTING",
        "VALIDATING",
        "PASSED",
        "INTEGRATING",
        "RELEASE_APPROVAL_REQUIRED",
        "RELEASING",
        "COMPLETE",
        "RETURN",
        "BLOCKED"
      ]
    },
    "pendingApprovalContext": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalActionType": {
      "enum": [
        "phaser-inspect",
        "phaser-spec-candidate",
        "phaser-prototype",
        "phaser-code-change",
        "phaser-asset-change",
        "phaser-ui-change",
        "phaser-audio-change",
        "phaser-balance-change",
        "phaser-qa-build",
        "phaser-integration",
        "phaser-build-upload",
        "phaser-backend-config",
        "phaser-channel-config",
        "phaser-device-test",
        "phaser-store-submit",
        "phaser-release",
        "phaser-game-rollback"
      ]
    },
    "pendingApprovalImpactSummary": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalFileScope": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalServices": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalAllowServiceStart": {
      "type": "boolean"
    },
    "pendingApprovalAllowDelete": {
      "type": "boolean"
    },
    "pendingApprovalExternalWrite": {
      "type": "boolean"
    },
    "pendingApprovalDestructive": {
      "type": "boolean"
    },
    "pendingApprovalPhysicalDevice": {
      "type": "boolean"
    },
    "pendingApprovalRelease": {
      "type": "boolean"
    },
    "pendingApprovalExternalTargets": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalPreparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "pendingApprovalPresentedId": {
      "type": [
        "string",
        "null"
      ]
    },
    "pendingApprovalPresentedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "validationBatchId": {
      "type": "string",
      "minLength": 1
    },
    "changeRequestFiles": {
      "$ref": "#/$defs/strings"
    },
    "moduleGateRequired": {
      "type": "boolean"
    },
    "substantiveTradeoffRequired": {
      "type": "boolean"
    },
    "visualDecisionRequired": {
      "type": "boolean"
    },
    "moduleApprovalId": {
      "type": "string"
    },
    "moduleApprovalBaselineHash": {
      "type": "string"
    },
    "grillingDecisionId": {
      "type": "string"
    },
    "grillingBaselineHash": {
      "type": "string"
    },
    "releaseWorkItem": {
      "type": "boolean"
    },
    "diffAuditRecord": {
      "type": "string"
    },
    "diffAuditLedgerRecord": {
      "type": [
        "string",
        "null"
      ]
    },
    "diffAuditAuthorizationRecord": {
      "type": "string"
    },
    "implementationPackageRecord": {
      "type": "string"
    },
    "previousApprovalRecord": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacyReadOnly": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pendingApprovalActionLevel": {
            "enum": [
              "A4",
              "A5",
              "A6"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalImpactSummary": {
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-inspect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-spec-candidate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-prototype"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-code-change",
              "phaser-asset-change",
              "phaser-ui-change",
              "phaser-audio-change",
              "phaser-balance-change",
              "phaser-qa-build"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-integration"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A4"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-build-upload",
              "phaser-backend-config",
              "phaser-channel-config"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A5"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-device-test",
              "phaser-store-submit",
              "phaser-release",
              "phaser-game-rollback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A6"
          }
        }
      }
    }
  ],
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "phaser-inspect",
          "phaser-spec-candidate",
          "phaser-prototype",
          "phaser-code-change",
          "phaser-asset-change",
          "phaser-ui-change",
          "phaser-audio-change",
          "phaser-balance-change",
          "phaser-qa-build",
          "phaser-integration",
          "phaser-build-upload",
          "phaser-backend-config",
          "phaser-channel-config",
          "phaser-device-test",
          "phaser-store-submit",
          "phaser-release",
          "phaser-game-rollback"
        ]
      }
    },
    "automaticPhaserActions": {
      "type": "array",
      "items": {
        "enum": [
          "phaser-inspect",
          "phaser-spec-candidate",
          "phaser-prototype",
          "phaser-code-change",
          "phaser-asset-change",
          "phaser-ui-change",
          "phaser-audio-change",
          "phaser-balance-change",
          "phaser-qa-build"
        ]
      }
    }
  }
}
