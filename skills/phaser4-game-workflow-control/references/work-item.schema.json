{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-work-item.schema.json",
  "title": "工作项",
  "type": "object",
  "required": ["workItemId", "projectId", "moduleId", "domain", "stageId", "globalState", "baselineId", "baselineVersion", "baselineHash", "objective", "inScope", "outOfScope", "approvedRequirements", "allowedActions", "allowedActionLevels", "prohibitedActions", "allowedPaths", "forbiddenPaths", "allowedExternalTargets", "protectedExternalTargets", "requiredGates", "approvalRecord", "assignedAgent", "delegatedAgents", "expectedOutputs", "validationPlan", "exitCriteria", "nextGate", "rollbackPolicy", "evidenceRoot", "pendingApprovalId", "pendingApprovalObject", "pendingApprovalStage", "pendingApprovalActionLevel", "pendingApprovalGate", "pendingApprovalState", "pendingApprovalContext", "pendingApprovalActionType", "pendingApprovalFileScope", "pendingApprovalServices", "pendingApprovalAllowServiceStart", "pendingApprovalAllowDelete", "pendingApprovalExternalWrite", "pendingApprovalDestructive", "pendingApprovalPhysicalDevice", "pendingApprovalRelease", "pendingApprovalExternalTargets", "validationBatchId", "changeRequestFiles"],
  "properties": {
    "workItemId": {"type": "string", "minLength": 1}, "projectId": {"type": "string", "minLength": 1}, "moduleId": {"type": "string", "minLength": 1}, "domain": {"type": "string", "minLength": 1}, "stageId": {"type": "string", "minLength": 1},
    "globalState": {"enum": ["INTAKE", "BASELINE", "PROPOSAL", "REVIEW", "APPROVAL_REQUIRED", "APPROVED", "IMPLEMENTING", "VALIDATING", "PASSED", "INTEGRATING", "RELEASE_APPROVAL_REQUIRED", "RELEASING", "COMPLETE", "RETURN", "BLOCKED"]},
    "baselineId": {"type": "string", "minLength": 1}, "baselineVersion": {"type": "string", "minLength": 1}, "baselineHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "objective": {"type": "string", "minLength": 1},
    "inScope": {"$ref": "#/$defs/strings"}, "outOfScope": {"$ref": "#/$defs/strings"}, "approvedRequirements": {"$ref": "#/$defs/strings"}, "allowedActions": {"$ref": "#/$defs/strings"}, "allowedActionLevels": {"type": "array", "items": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]}}, "prohibitedActions": {"$ref": "#/$defs/strings"}, "allowedPaths": {"$ref": "#/$defs/strings"}, "forbiddenPaths": {"$ref": "#/$defs/strings"}, "allowedExternalTargets": {"$ref": "#/$defs/strings"}, "protectedExternalTargets": {"$ref": "#/$defs/strings"}, "requiredGates": {"type": "array", "items": {"enum": ["F0", "F1", "F2", "F3", "F4"]}},
    "approvalRecord": {"type": ["string", "null"]}, "assignedAgent": {"type": "string", "minLength": 1}, "delegatedAgents": {"$ref": "#/$defs/strings"}, "expectedOutputs": {"$ref": "#/$defs/strings"}, "validationPlan": {"$ref": "#/$defs/strings"}, "exitCriteria": {"$ref": "#/$defs/strings"}, "nextGate": {"enum": ["F0", "F1", "F2", "F3", "F4"]}, "rollbackPolicy": {"type": "string", "minLength": 1}, "evidenceRoot": {"type": "string", "minLength": 1},
    "pendingApprovalId": {"type": "string", "minLength": 1}, "pendingApprovalObject": {"type": "string", "minLength": 1}, "pendingApprovalStage": {"type": "string", "minLength": 1}, "pendingApprovalActionLevel": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6"]}, "pendingApprovalGate": {"enum": ["F0", "F1", "F2", "F3", "F4"]}, "pendingApprovalState": {"enum": ["INTAKE", "BASELINE", "PROPOSAL", "REVIEW", "APPROVAL_REQUIRED", "APPROVED", "IMPLEMENTING", "VALIDATING", "PASSED", "INTEGRATING", "RELEASE_APPROVAL_REQUIRED", "RELEASING", "COMPLETE", "RETURN", "BLOCKED"]}, "pendingApprovalContext": {"type": "string", "minLength": 1}, "pendingApprovalActionType": {"type": "string", "minLength": 1}, "pendingApprovalFileScope": {"$ref": "#/$defs/strings"}, "pendingApprovalServices": {"$ref": "#/$defs/strings"}, "pendingApprovalAllowServiceStart": {"type": "boolean"}, "pendingApprovalAllowDelete": {"type": "boolean"}, "pendingApprovalExternalWrite": {"type": "boolean"}, "pendingApprovalDestructive": {"type": "boolean"}, "pendingApprovalPhysicalDevice": {"type": "boolean"}, "pendingApprovalRelease": {"type": "boolean"}, "pendingApprovalExternalTargets": {"$ref": "#/$defs/strings"}, "validationBatchId": {"type": "string", "minLength": 1}, "changeRequestFiles": {"$ref": "#/$defs/strings"},
    "moduleGateRequired": {"type": "boolean"}, "moduleApprovalId": {"type": "string"}, "moduleApprovalBaselineHash": {"type": "string"}, "grillingDecisionId": {"type": "string"}, "grillingBaselineHash": {"type": "string"}, "releaseWorkItem": {"type": "boolean"}, "diffAuditRecord": {"type": "string"}, "diffAuditLedgerRecord": {"type": "string"}, "diffAuditApprovalRecord": {"type": "string"}, "implementationApprovalRecord": {"type": "string"}, "implementationPackageRecord": {"type": "string"}, "previousApprovalRecord": {"type": ["string", "null"]}, "legacyReadOnly": {"type": "boolean"}
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string"}}}
}
