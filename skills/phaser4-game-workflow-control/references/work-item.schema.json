{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phaser4-work-item.schema.json",
  "title": "工作项",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workItemId",
    "projectId",
    "moduleIds",
    "domain",
    "stageId",
    "globalState",
    "baselineId",
    "baselineVersion",
    "baselineHash",
    "objective",
    "taskAuthorization",
    "inScope",
    "outOfScope",
    "approvedRequirements",
    "allowedActions",
    "allowedActionLevels",
    "explicitApprovalActionLevels",
    "prohibitedActions",
    "allowedPaths",
    "forbiddenPaths",
    "allowedExternalTargets",
    "protectedExternalTargets",
    "requiredGates",
    "approvalRecord",
    "assignedAgent",
    "delegatedAgents",
    "expectedOutputs",
    "validationPlan",
    "exitCriteria",
    "nextGate",
    "rollbackPolicy",
    "evidenceRoot",
    "pendingApprovalId",
    "pendingApprovalObject",
    "pendingApprovalStage",
    "pendingApprovalActionLevel",
    "pendingApprovalGate",
    "pendingApprovalState",
    "pendingApprovalContext",
    "pendingApprovalActionType",
    "pendingApprovalImpactSummary",
    "pendingApprovalFileScope",
    "pendingApprovalServices",
    "pendingApprovalAllowServiceStart",
    "pendingApprovalAllowDelete",
    "pendingApprovalExternalWrite",
    "pendingApprovalDestructive",
    "pendingApprovalPhysicalDevice",
    "pendingApprovalRelease",
    "pendingApprovalExternalTargets",
    "pendingApprovalPreparedAt",
    "pendingApprovalPresentedId",
    "pendingApprovalPresentedAt",
    "validationBatchId",
    "changeRequestFiles"
  ],
  "properties": {
    "workItemId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "moduleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "stageId": {
      "type": "string",
      "minLength": 1
    },
    "visualStage": {
      "enum": ["V0", "V1", "V2", "V3", "V4", "V5"]
    },
    "visualStageState": {
      "enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "global-static-baseline-frozen", "v2-direction-frozen", "v3-production-planning-complete", "v4-formal-acceptance-complete", "v5-runtime-integration-candidate"]
    },
    "globalStaticBaselineState": {"const": "global-static-baseline-frozen"},
    "visualStageEvidenceRefs": {
      "type": "object",
      "properties": {
        "V2": {"$ref": "#/$defs/visualStageEvidenceReference"},
        "V3": {"$ref": "#/$defs/visualStageEvidenceReference"},
        "V4": {"$ref": "#/$defs/visualStageEvidenceReference"},
        "V5": {"$ref": "#/$defs/visualStageEvidenceReference"}
      },
      "additionalProperties": false
    },
    "visualHumanApproval": {"$ref": "#/$defs/visualHumanApproval"},
    "visual_human_approval": {"$ref": "#/$defs/visualHumanApproval"},
    "visualIntegration": {
      "type": "object",
      "properties": {
        "registersFormalScene": {"type": "boolean"},
        "replacesFormalScene": {"type": "boolean"},
        "modifiesBootEntry": {"type": "boolean"},
        "registersProductionEntry": {"type": "boolean"},
        "formalRuntimeConsumption": {"type": "boolean"},
        "deletesLegacyVisualImplementation": {"type": "boolean"},
        "declaresVisualComplete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "visibleVisualProductionIntegration": {"type": "boolean"},
    "graybox": {"type": "boolean"},
    "isolatedPrototype": {"type": "boolean"},
    "pendingVisualPrerequisiteSnapshot": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "pendingApprovalStatus": {"enum": ["pending", "stale", "invalid"]},
    "sceneReconstructionContract": {
      "type": "object",
      "description": "effect-image V1-V5 场景还原合同；缺失时不得把独立资源工件视为完整还原。",
      "required": ["contract_version", "reference_technical_conflicts", "target_conditions", "coverage_regions", "composition", "responsive_contract", "predeclared_tolerances", "implementation_plan"],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "reference_technical_conflicts": {"$ref": "#/$defs/referenceTechnicalConflicts"},
        "v2_scene_candidate": {"$ref": "#/$defs/v2Artifact"},
        "v2_dynamic_sample": {"$ref": "#/$defs/v2Artifact"},
        "v2_structured_review": {"$ref": "#/$defs/v2StructuredReview"},
        "target_conditions": {"type": "object"},
        "coverage_regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sceneCoverageRegion"}},
        "composition": {"type": "object"},
        "responsive_contract": {"type": "object"},
        "predeclared_tolerances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "rules"]}},
        "implementation_plan": {"type": "object"},
        "combination_preacceptance": {"$ref": "#/$defs/combinationPreacceptance"}
      },
      "additionalProperties": true
    },
    "scene_reconstruction_contract": {
      "type": "object",
      "description": "effect-image V1-V5 场景还原合同；snake_case 入口同样必须显式提供完整合同。",
      "required": ["contract_version", "reference_technical_conflicts", "target_conditions", "coverage_regions", "composition", "responsive_contract", "predeclared_tolerances", "implementation_plan"],
      "properties": {
        "contract_version": {"type": "string", "minLength": 1},
        "reference_technical_conflicts": {"$ref": "#/$defs/referenceTechnicalConflicts"},
        "v2_scene_candidate": {"$ref": "#/$defs/v2Artifact"},
        "v2_dynamic_sample": {"$ref": "#/$defs/v2Artifact"},
        "v2_structured_review": {"$ref": "#/$defs/v2StructuredReview"},
        "target_conditions": {"type": "object"},
        "coverage_regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sceneCoverageRegion"}},
        "composition": {"type": "object"},
        "responsive_contract": {"type": "object"},
        "predeclared_tolerances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "rules"]}},
        "implementation_plan": {"type": "object"},
        "combination_preacceptance": {"type": "object"}
      },
      "additionalProperties": true
    },
    "globalState": {
      "enum": [
        "INTAKE",
        "BASELINE",
        "PROPOSAL",
        "REVIEW",
        "IMPLEMENTING",
        "VALIDATING",
        "PASSED",
        "INTEGRATING",
        "RELEASE_APPROVAL_REQUIRED",
        "RELEASING",
        "COMPLETE",
        "RETURN",
        "BLOCKED"
      ]
    },
    "baselineId": {
      "type": "string",
      "minLength": 1
    },
    "baselineVersion": {
      "type": "string",
      "minLength": 1
    },
    "baselineHash": {
      "type": "string",
      "pattern": "^(?:sha256:[a-f0-9]{64}|[a-f0-9]{40}(?:[a-f0-9]{24})?)$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "taskAuthorization": {
      "type": "object",
      "required": [
        "authorizationId",
        "userOriginalText",
        "authorizedObjective",
        "authorizedScope",
        "authorizedActions",
        "authorizedActionLevels",
        "authorizedPaths",
        "authorizedAt"
      ],
      "properties": {
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "userOriginalText": {
          "type": "string",
          "minLength": 1
        },
        "authorizedObjective": {
          "type": "string",
          "minLength": 1
        },
        "authorizedScope": {
          "$ref": "#/$defs/strings"
        },
        "authorizedActions": {
          "$ref": "#/$defs/automaticPhaserActions"
        },
        "authorizedActionLevels": {
          "type": "array",
          "items": {
            "enum": [
              "A0",
              "A1",
              "A2",
              "A3"
            ]
          }
        },
        "authorizedPaths": {
          "$ref": "#/$defs/strings"
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time"
        },
        "visualConfirmationPrerequisiteFiles": {
          "$ref": "#/$defs/strings"
        },
        "visualConfirmationPrerequisiteFilesSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inScope": {
      "$ref": "#/$defs/strings"
    },
    "outOfScope": {
      "$ref": "#/$defs/strings"
    },
    "approvedRequirements": {
      "$ref": "#/$defs/strings"
    },
    "allowedActions": {
      "$ref": "#/$defs/actions"
    },
    "allowedActionLevels": {
      "type": "array",
      "items": {
        "enum": [
          "A0",
          "A1",
          "A2",
          "A3"
        ]
      }
    },
    "explicitApprovalActionLevels": {
      "type": "array",
      "items": {
        "enum": [
          "A4",
          "A5",
          "A6"
        ]
      }
    },
    "prohibitedActions": {
      "$ref": "#/$defs/actions"
    },
    "allowedPaths": {
      "$ref": "#/$defs/strings"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/strings"
    },
    "allowedExternalTargets": {
      "$ref": "#/$defs/strings"
    },
    "protectedExternalTargets": {
      "$ref": "#/$defs/strings"
    },
    "requiredGates": {
      "type": "array",
      "items": {
        "enum": [
          "F0",
          "F1",
          "F2",
          "F3",
          "F4"
        ]
      }
    },
    "approvalRecord": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignedAgent": {
      "type": "string",
      "minLength": 1
    },
    "delegatedAgents": {
      "$ref": "#/$defs/strings"
    },
    "expectedOutputs": {
      "$ref": "#/$defs/strings"
    },
    "validationPlan": {
      "$ref": "#/$defs/strings"
    },
    "exitCriteria": {
      "$ref": "#/$defs/strings"
    },
    "nextGate": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ]
    },
    "rollbackPolicy": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRoot": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalId": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalObject": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalStage": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalActionLevel": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6"
      ]
    },
    "pendingApprovalGate": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ]
    },
    "pendingApprovalState": {
      "enum": [
        "INTAKE",
        "BASELINE",
        "PROPOSAL",
        "REVIEW",
        "IMPLEMENTING",
        "VALIDATING",
        "PASSED",
        "INTEGRATING",
        "RELEASE_APPROVAL_REQUIRED",
        "RELEASING",
        "COMPLETE",
        "RETURN",
        "BLOCKED"
      ]
    },
    "pendingApprovalContext": {
      "type": "string",
      "minLength": 1
    },
    "pendingApprovalActionType": {
      "enum": [
        "phaser-inspect",
        "phaser-spec-candidate",
        "phaser-prototype",
        "phaser-code-change",
        "phaser-asset-change",
        "phaser-ui-change",
        "phaser-audio-change",
        "phaser-balance-change",
        "phaser-qa-build",
        "phaser-integration",
        "phaser-build-upload",
        "phaser-backend-config",
        "phaser-channel-config",
        "phaser-device-test",
        "phaser-store-submit",
        "phaser-release",
        "phaser-game-rollback"
      ]
    },
    "pendingApprovalImpactSummary": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalFileScope": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalServices": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalAllowServiceStart": {
      "type": "boolean"
    },
    "pendingApprovalAllowDelete": {
      "type": "boolean"
    },
    "pendingApprovalExternalWrite": {
      "type": "boolean"
    },
    "pendingApprovalDestructive": {
      "type": "boolean"
    },
    "pendingApprovalPhysicalDevice": {
      "type": "boolean"
    },
    "pendingApprovalRelease": {
      "type": "boolean"
    },
    "pendingApprovalExternalTargets": {
      "$ref": "#/$defs/strings"
    },
    "pendingApprovalPreparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "pendingApprovalPresentedId": {
      "type": [
        "string",
        "null"
      ]
    },
    "pendingApprovalPresentedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "validationBatchId": {
      "type": "string",
      "minLength": 1
    },
    "changeRequestFiles": {
      "$ref": "#/$defs/strings"
    },
    "moduleGateRequired": {
      "type": "boolean"
    },
    "substantiveTradeoffRequired": {
      "type": "boolean"
    },
    "visualDecisionRequired": {
      "type": "boolean"
    },
    "visualConfirmationAuthorityRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/visualConfirmationAuthorityRef"}
    },
    "moduleApprovalId": {
      "type": "string"
    },
    "moduleApprovalBaselineHash": {
      "type": "string"
    },
    "grillingDecisionId": {
      "type": "string"
    },
    "grillingBaselineHash": {
      "type": "string"
    },
    "releaseWorkItem": {
      "type": "boolean"
    },
    "diffAuditRecord": {
      "type": "string"
    },
    "diffAuditLedgerRecord": {
      "type": [
        "string",
        "null"
      ]
    },
    "diffAuditAuthorizationRecord": {
      "type": "string"
    },
    "implementationPackageRecord": {
      "type": "string"
    },
    "previousApprovalRecord": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacyReadOnly": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {"required": ["visualStage"], "properties": {"visualStage": {"enum": ["V0", "V1"]}}},
      "then": {"required": ["visualStageState"], "properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "global-static-baseline-frozen"]}}}
    },
    {
      "if": {"required": ["visualStage"], "properties": {"visualStage": {"const": "V2"}}},
      "then": {"required": ["visualStageState"], "properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v2-direction-frozen"]}}}
    },
    {
      "if": {"required": ["visualStage"], "properties": {"visualStage": {"const": "V3"}}},
      "then": {"required": ["visualStageState"], "properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v3-production-planning-complete"]}}}
    },
    {
      "if": {"required": ["visualStage"], "properties": {"visualStage": {"const": "V4"}}},
      "then": {"required": ["visualStageState"], "properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v4-formal-acceptance-complete"]}}}
    },
    {
      "if": {"required": ["visualStage"], "properties": {"visualStage": {"const": "V5"}}},
      "then": {"required": ["visualStageState"], "properties": {"visualStageState": {"enum": ["not-started", "in-progress", "pending", "failed", "stale", "invalid", "v5-runtime-integration-candidate"]}}}
    },
    {
      "if": {"required": ["stageId"], "properties": {"stageId": {"pattern": "^V[0-9]+$"}}},
      "then": {
        "required": ["visualStage", "visualStageState"],
        "properties": {
          "visualStage": {"enum": ["V0", "V1", "V2", "V3", "V4", "V5"]},
          "visualStageState": {"not": {"const": "frozen"}}
        }
      }
    },
    {
      "if": {"required": ["stageId"], "properties": {"stageId": {"enum": ["V2", "V3", "V4", "V5"]}}},
      "then": {
        "anyOf": [
          {"required": ["sceneReconstructionContract"], "properties": {"sceneReconstructionContract": {"required": ["v2_scene_candidate", "v2_dynamic_sample", "v2_structured_review"]}}},
          {"required": ["scene_reconstruction_contract"], "properties": {"scene_reconstruction_contract": {"required": ["v2_scene_candidate", "v2_dynamic_sample", "v2_structured_review"]}}}
        ]
      }
    },
    {
      "if": {"required": ["stageId"], "properties": {"stageId": {"enum": ["V4", "V5"]}}},
      "then": {
        "anyOf": [
          {"required": ["sceneReconstructionContract"], "properties": {"sceneReconstructionContract": {"required": ["combination_preacceptance"]}}},
          {"required": ["scene_reconstruction_contract"], "properties": {"scene_reconstruction_contract": {"required": ["combination_preacceptance"]}}}
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionLevel": {
            "enum": [
              "A4",
              "A5",
              "A6"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalImpactSummary": {
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-inspect"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-spec-candidate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-prototype"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-code-change",
              "phaser-asset-change",
              "phaser-ui-change",
              "phaser-audio-change",
              "phaser-balance-change",
              "phaser-qa-build"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-integration"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A4"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-build-upload",
              "phaser-backend-config",
              "phaser-channel-config"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A5"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pendingApprovalActionType": {
            "enum": [
              "phaser-device-test",
              "phaser-store-submit",
              "phaser-release",
              "phaser-game-rollback"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pendingApprovalActionLevel": {
            "const": "A6"
          }
        }
      }
    }
  ],
  "$defs": {
    "visualStageEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "workItemId": {"type": "string", "minLength": 1},
        "resultId": {"type": "string", "minLength": 1},
        "unitResultId": {"type": "string", "minLength": 1}
      }
    },
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "referenceTechnicalConflicts": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "artifactIdentity": {
      "type": "object",
      "required": ["diff_fingerprint"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "diff_fingerprint": {"type": "string", "minLength": 1},
        "diff_identity": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["sha256"]}, {"required": ["code_sha256"]}, {"required": ["build_sha256"]}, {"required": ["candidate_sha256"]}]
    },
    "evidenceValue": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "items": {"type": ["string", "object"]}}, {"type": "object", "minProperties": 1}]},
    "visualHumanApproval": {"type": "object", "required": ["review_id", "reviewed_at", "evidence", "evidence_sha256", "status", "target_sha256", "candidate_sha256", "diff_fingerprint", "baseline_sha256"], "properties": {"review_id": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}, "evidence": {"$ref": "#/$defs/evidenceValue"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["passed", "PASS"]}, "target_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "diff_fingerprint": {"type": "string", "minLength": 1}, "baseline_sha256": {"$ref": "#/$defs/sha256"}}, "not": {"anyOf": [{"required": ["reviewer_type"]}, {"required": ["reviewerType"]}, {"required": ["reviewer_id"]}, {"required": ["reviewerId"]}, {"required": ["reviewer"]}, {"required": ["f2_review"]}, {"required": ["f2_reviews"]}, {"required": ["visual_fidelity_review"]}, {"required": ["visualFidelityReview"]}, {"required": ["production_contract_review"]}, {"required": ["productionContractReview"]}, {"required": ["component_reviews"]}, {"required": ["componentReviews"]}, {"required": ["human_review"]}]}, "additionalProperties": true},
    "v2Artifact": {
      "type": "object",
      "required": ["identity", "evidence"],
      "properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "evidence": {"$ref": "#/$defs/evidenceValue"}, "visual_human_approval_id": {"type": "string", "minLength": 1}, "visual_human_approval_sha256": {"$ref": "#/$defs/sha256"}},
